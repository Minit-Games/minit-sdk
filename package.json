{
  "name": "@minit-games/sdk",
  "version": "1.14.0",
  "description": "Official SDK for building Minit Games HTML5 mini-games",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui/index.js",
      "types": "./dist/ui/index.d.ts"
    }
  },
  "sideEffects": [
    "**/modules/tutorial/**"
  ],
  "files": [
    "dist",
    "licenses"
  ],
  "scripts": {
    "build": "node scripts/bundle-tutorial-assets.mjs && tsc --project tsconfig.json && node scripts/copy-tutorial-assets.mjs",
    "check": "node scripts/bundle-tutorial-assets.mjs && tsc --project tsconfig.json --noEmit",
    "test": "node scripts/bundle-tutorial-assets.mjs && jest",
    "preview:tutorial": "npm run build && node scripts/preview-tutorial.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "minit",
    "games",
    "sdk",
    "html5"
  ],
  "author": "Drop GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minit-Games/minit-sdk.git"
  },
  "homepage": "https://github.com/Minit-Games/minit-sdk",
  "dependencies": {
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/seedrandom": "^3.0.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2"
  }
}
